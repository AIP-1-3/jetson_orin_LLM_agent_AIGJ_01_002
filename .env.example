# 복사해서 .env 로 저장한 뒤 값을 채운다: cp .env.example .env
# .env 는 .gitignore 에 있어 git 에 올라가지 않는다. 카메라 계정은 여기에만 둔다.

# TP-Link VIGI IP 카메라 RTSP 주소. 계정은 VIGI 앱의 카메라 계정(장치 계정)이다.
# 경로는 보통 stream1(메인, 고해상도) / stream2(서브, 저해상도). 실시간 검출에는 stream2 가 가볍다.
# 계정에 @ : / # ? % 같은 기호가 있으면 URL 규칙에 맞게 바꿔 적는다. 예: @ → %40, : → %3A
#   (사용자 이름 user@example.com → user%40example.com)
CAM_URL=rtsp://CAMERA_USER:CAMERA_PASSWORD@CAMERA_IP:554/stream2

# 테스트 자료 폴더 (기본: 저장소의 media/)
# EG2_MEDIA=/home/aip-1-3/eg2-media
